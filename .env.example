# TradeShark environment template
# Never put real credentials in this file.

NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

DATABASE_URL=postgresql://tradeshark:tradeshark@localhost:5432/tradeshark
REDIS_URL=redis://localhost:6379

# Authentication
AUTH_SECRET=replace-with-a-local-development-secret

# Product configuration
MIN_DEPOSIT=2.50
MIN_WITHDRAWAL=10.00
TRADING_FEE_RATE=0.0055
MAYHEM_FREE_DURATION_SECONDS=60

# Analytics
POSTHOG_KEY=
POSTHOG_HOST=
